# Copy to .env.local and fill in what you need. Everything is optional —
# without any of these the tour uses its pre-rendered Tamil/English voice
# clips and opens WhatsApp's generic share sheet.

# ---- Optional neural text-to-speech (server-side only, never sent to the browser) ----
# Pick ONE provider. Only sentences from src/config/narration.ts can be synthesised.
TTS_PROVIDER=            # google | azure | elevenlabs

GOOGLE_TTS_API_KEY=
# Optional overrides per language/gender (defaults: ta-IN/en-IN Wavenet A = female, B = male)
GOOGLE_TTS_VOICE_TA_FEMALE=
GOOGLE_TTS_VOICE_TA_MALE=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Voices come from src/config/voices.ts (Pallavi / Valluvar, Tamil Nadu).
# The same key is used by `npm run narration:render` for licensed pre-rendering.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_MALE=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ---- Public settings (inlined into the client bundle at build time) ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=          # digits with country code, e.g. 919876543210
NEXT_PUBLIC_MUSIC_URL=                # override the bundled ambient loop
NEXT_PUBLIC_SOCIAL_WEBSITE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
