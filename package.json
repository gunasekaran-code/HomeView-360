{
  "name": "home-360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "narration:render": "node --experimental-strip-types --no-warnings scripts/narration/render.mts",
    "panoramas:build": ".venv-pano/bin/python scripts/panorama/build_panoramas.py",
    "music:generate": ".venv-pano/bin/python scripts/music/generate_ambient.py",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "~1.20.13",
    "@photo-sphere-viewer/autorotate-plugin": "~5.15.1",
    "@photo-sphere-viewer/core": "~5.15.1",
    "@photo-sphere-viewer/markers-plugin": "~5.15.1",
    "next": "16.4.2",
    "qrcode": "~1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "~0.0.1",
    "three": "~0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "~1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "~0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "~4.152.0"
  }
}
